{
  "name": "@avcs/autosuggest",
  "version": "2.0.0",
  "description": "A headless React + TypeScript plugin to implement IDE like autocompletion in input, textarea or contenteditable fields.",
  "type": "module",
  "main": "dist/autosuggest.cjs",
  "module": "dist/autosuggest.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/autosuggest.js",
      "require": "./dist/autosuggest.cjs"
    }
  },
  "sideEffects": false,
  "repository": "git@github.com:avcs06/autosuggest.git",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:lib && npm run build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite --config demo/vite.config.ts",
    "prepublish": "npm run build"
  },
  "keywords": [
    "autocomplete",
    "suggest",
    "textarea",
    "contenteditable",
    "dropdown",
    "react",
    "hook",
    "headless",
    "typescript"
  ],
  "author": "AvcS",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/invariant": "^2.2.37",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "invariant": "^2.2.4"
  }
}
