{
  "name": "@avcs/autosuggest",
  "version": "2.0.0",
  "description": "A headless React + TypeScript hook to implement IDE like autocompletion in input, textarea or contenteditable fields.",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "repository": "git@github.com:avcs06/autosuggest.git",
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite demo",
    "demo:build": "vite build demo"
  },
  "keywords": [
    "autocomplete",
    "suggest",
    "textarea",
    "contenteditable",
    "dropdown",
    "react",
    "headless",
    "hook"
  ],
  "author": "AvcS",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/invariant": "^2.2.37",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "invariant": "^2.2.4"
  }
}
